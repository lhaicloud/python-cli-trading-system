[Unit]
Description=LQ-MTF Universe Sync (daily backfill + backtest new coins)
Documentation=https://github.com/lhaicloud/python-cli-trading-system
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/lqmtf

Environment="PATH=/home/ubuntu/lqmtf/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/ubuntu/lqmtf/.env

ExecStart=/home/ubuntu/lqmtf/venv/bin/python main.py sync-universe --top 50 --min-volume 50000000

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lqmtf-sync
