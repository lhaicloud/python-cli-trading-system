# Copy this to /home/ubuntu/lqmtf/.env on the server and fill in values.
# The local .env is NOT pushed automatically (it contains secrets).

BINANCE_BASE_URL=https://fapi.binance.com
BACKTEST_FEE_PCT=0.05
LEVERAGE=1

DB_PATH=data/db/lqmtf.db
MODEL_DIR=data/models
LOG_FILE=data/lqmtf.log
LOG_LEVEL=INFO

DEFAULT_SYMBOL=BTCUSDT
DEFAULT_CAPITAL=10000.0
DEFAULT_RISK_PCT=1.0
DEFAULT_MAX_DAILY_LOSS_PCT=3.0
MIN_RR_RATIO=1.8
MIN_ZONE_SCORE=60.0
MIN_SIGNAL_CONFIDENCE=65.0

MTF_TF_WEIGHT_1W=0.15
MTF_TF_WEIGHT_1D=0.20
MTF_TF_WEIGHT_12H=0.15
MTF_TF_WEIGHT_4H=0.22
MTF_TF_WEIGHT_1H=0.18
MTF_TF_WEIGHT_30M=0.10
MTF_MIN_SCORE=55.0
MTF_MIN_SCORE_GAP=15.0
MTF_RSI_OVERBOUGHT=70.0
MTF_RSI_OVERSOLD=30.0
MTF_EMA200_STRICT=true
MTF_MIN_VOLUME_RATIO=0.8
MTF_RATCHET_ENABLED=true

# ── Telegram (paper trading channel) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Live execution — Binance Futures API ──────────────────────────────────────
# Get keys from Binance → API Management. Start with BINANCE_TESTNET=true.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ── Live trading parameters (independent from paper) ──────────────────────────
LIVE_RISK_PCT=1.0
LIVE_MAX_PORTFOLIO=3
LIVE_MAX_SAME_DIR=2
LIVE_MAX_DAILY_LOSS_PCT=3.0
# Leverage: start at 1 (testnet). After verification set to 10.
# dynamic_leverage() scales 1x-Nx by confidence/zone/R:R/regime.
# 3+ consecutive losses forces back to 1x regardless of this ceiling.
LIVE_MAX_LEVERAGE=1

# ── Telegram (live channel — separate bot + separate chat) ────────────────────
# All live alerts prefixed 🔴 [LIVE]. Paper channel is never touched.
LIVE_TELEGRAM_TOKEN=
LIVE_TELEGRAM_CHAT_ID=
