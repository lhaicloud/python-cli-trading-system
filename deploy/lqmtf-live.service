[Unit]
Description=LQ-MTF Live Execution Watcher (real Binance Futures orders)
Documentation=https://github.com/lhaicloud/python-cli-trading-system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/lqmtf

Environment="PATH=/root/lqmtf/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/root/lqmtf/.env

# SAFETY: --yes only skips the TTY confirm. It does NOT satisfy
# OWNER_AUTHORIZATION or RISK_APPROVED. Do not set those true in this unit.
# HALT NEW TRADING remains policy. Optional extra halt (does not enable live):
#   Environment=LIVE_HALT=true
# Optional: remove --yes so a missing TTY cannot skip confirm; systemd
# still cannot answer typer.confirm, so a headless start without Owner/Risk
# is denied by app/live/live_entry_auth.py regardless of --yes.

ExecStart=/root/lqmtf/venv/bin/python main.py live \
    --auto \
    --rescan-every 144 \
    --risk 1.0 \
    --heartbeat 8 \
    --live-execution \
    --yes

ExecStopPost=/root/lqmtf/venv/bin/python -m scripts.live_service_watchdog

Restart=always
RestartSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lqmtf-live

KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
