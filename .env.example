# LQ-MTF Strategy — Environment Variables
# Copy this file to .env and fill in your values

# Database
DB_PATH=data/db/lqmtf.db

# Binance (public endpoints only — no API key required for candle data)
BINANCE_BASE_URL=https://api.binance.com

# Optional proxy — REQUIRED when running on a US-hosted server (GCP us-* etc.),
# since Binance returns HTTP 451 to US IPs. Route traffic through a non-US proxy.
#   http://user:pass@host:port   (HTTP/HTTPS proxy)
#   socks5://user:pass@host:port (SOCKS5 — also run: pip install "httpx[socks]")
# Leave empty for direct connection (e.g. when running locally outside the US).
BINANCE_PROXY_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/lqmtf.log

# Model storage
MODEL_DIR=data/models

# Trading defaults
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_CAPITAL=10000.0
DEFAULT_RISK_PCT=1.0
DEFAULT_MAX_DAILY_LOSS_PCT=3.0
MIN_RR_RATIO=2.0

# Leverage: 1 = spot/no leverage (default). Set to 2-10 for futures testing only.
# WARNING: leverage > 1 inflates backtest results and is not used in live paper trading
# unless you intentionally run on a futures account.
LEVERAGE=1
MIN_ZONE_SCORE=65.0
MIN_SIGNAL_CONFIDENCE=70.0

# Backtest defaults
BACKTEST_FEE_PCT=0.1
BACKTEST_SLIPPAGE_PCT=0.05

# ── MTF Strategy Settings ────────────────────────────────────────────────────
# Timeframe weights (should sum to 1.0)
MTF_TF_WEIGHT_1D=0.25
MTF_TF_WEIGHT_12H=0.20
MTF_TF_WEIGHT_4H=0.25
MTF_TF_WEIGHT_1H=0.20
MTF_TF_WEIGHT_30M=0.10

# Score thresholds
MTF_MIN_SCORE=55.0
MTF_MIN_SCORE_GAP=15.0

# Entry filters
MTF_RSI_OVERBOUGHT=70.0
MTF_RSI_OVERSOLD=30.0
MTF_EMA200_STRICT=true
MTF_MIN_VOLUME_RATIO=0.8

# Ratchet stop
MTF_RATCHET_ENABLED=true

# ── Telegram Notifications ────────────────────────────────────────────────────
# Step 1: Message @BotFather on Telegram → /newbot → copy the token below
# Step 2: Start a chat with your bot, then open this URL in a browser:
#         https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#         Find the "id" field inside "chat" — that is your TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ── Live entry fail-closed gates (safety stub) ───────────────────────────────
# Defaults unset/false = DENY new live entries. --yes never satisfies these.
# LIVE_HALT=true           # deny all new live even if Owner+Risk set
# OWNER_AUTHORIZATION=     # must be explicit true/1 for new live entries
# RISK_APPROVED=           # must be explicit true/1 (prefer per-trade + intent)
# TRADE_INTENT_ID=         # optional; required when RISK_APPROVED is per-trade
# Do NOT commit OWNER_AUTHORIZATION=true or RISK_APPROVED=true in examples.
#
# ── Model path (KEEP ML OFF) ─────────────────────────────────────────────────
# MODEL_PATH_FALLBACK_NESTED=false   # default OFF; true can suddenly enable nested models
